# Copy to .env (which is gitignored) and fill with REAL secrets.
# docker-compose.yml reads these via ${VAR_NAME}.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=devsecops
MYSQL_USER=pfe
MYSQL_PASSWORD=change-me-app

# --- Backend datasource (talks to the `mysql` service inside the compose network) ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/devsecops?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-root
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- JWT (must be >= 32 bytes) ---
# Generate a fresh one with e.g.:
#   PowerShell:  $b=New-Object byte[] 48;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
#   openssl:     openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-48-byte-base64-string
APP_JWT_EXPIRATION_MS=86400000
